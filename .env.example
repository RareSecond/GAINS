APP_ORIGIN=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000/api/auth
# Exact OAuth resource/audience for a tunnel; blank uses APP_ORIGIN/mcp.
MCP_RESOURCE_URL=
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
DATABASE_URL=postgresql://user:password@host/gains?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@host/gains?sslmode=require
PORT=3000
NODE_ENV=development
