{
  "name": "gains",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "npm run db:generate",
    "dev": "vite --host 127.0.0.1 --port 3000",
    "prebuild": "npm run db:generate",
    "build": "vite build",
    "start": "node --env-file=.env .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --env-file-if-exists=.env.test --import tsx --test tests/*.test.ts",
    "test:browser": "node --env-file-if-exists=.env.test --import tsx --test tests/*.browser.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:dev": "prisma migrate dev",
    "db:auth-schema": "auth generate --config src/server/auth-schema.ts --output prisma/schema.prisma --yes"
  },
  "dependencies": {
    "@better-auth/cimd": "1.7.7",
    "@better-auth/mcp": "1.7.7",
    "@better-auth/oauth-provider": "1.7.7",
    "@modelcontextprotocol/server": "2.3.0",
    "@prisma/client": "6.19.3",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "better-auth": "1.7.7",
    "lucide-react": "1.52.0",
    "nitro": "^3.0.260903-beta",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.0",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "auth": "^1.7.7",
    "playwright": "1.63.0",
    "prisma": "6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
